GEMINI_API_KEY=tu_key_aca

# opcional: si la definis, pide esta clave antes de dejar usar el chat
# (recomendado ahora que no hay limite de mensajes)
ACCESS_PASSWORD=

# opcional: nombre que el mayordomo dice cuando le preguntan quien lo creo
MAYORDOMO_CREADOR=Ezequiel Carrion, CEO de Easyrae Tecnologia

# opcional: modelo de respaldo si el principal de Gemini esta saturado
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# opcional: tercer proveedor de ultimo recurso (infraestructura distinta a
# Google), por si los dos modelos de Gemini fallan a la vez. Gratis en
# console.groq.com. Si la dejas vacia, este nivel no existe y no rompe nada.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
